<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Couche INFRASTRUCTURE : adaptateurs concrets des ports définis dans Application.
    (client REST Azure DevOps, persistance JSON, DPAPI, registre Windows, logs fichier)
  -->
  <PropertyGroup>
    <RootNamespace>CSharpForgeWatcher.Infrastructure</RootNamespace>
    <!-- DPAPI + registre : cet assembly est volontairement Windows-only. -->
    <TargetFramework>net9.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSharpForgeWatcher.Application\CSharpForgeWatcher.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
