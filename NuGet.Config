<?xml version="1.0" encoding="utf-8"?>
<!--
  Sources NuGet du dépôt.

  <clear /> est volontaire : sans lui, les sources définies dans le NuGet.Config machine
  ou utilisateur (flux d'entreprise, cache hors ligne de Visual Studio) s'ajoutent à
  celle-ci. Le résultat serait un « ça restaure chez moi, pas en CI » classique.
  Avec <clear />, tout le monde — poste de dev, GitHub Actions, GitLab CI — restaure
  exactement les mêmes paquets depuis les mêmes sources.

  Pour ajouter un flux privé, préférez un NuGet.Config local non versionné ou une
  variable d'environnement, afin de ne pas rendre le dépôt dépendant d'un flux interne.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
